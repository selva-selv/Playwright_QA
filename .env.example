# ── App under test ──────────────────────────────────────────────────────────────
BASE_URL=https://measurement-dashboard-dev.magicktech.com
TEST_ENV=dev

# ── Test credentials ─────────────────────────────────────────────────────────────
TEST_ENTERPRISE_ID=
TEST_EMAIL=
TEST_PASSWORD=
TEST_INVALID_EMAIL=wrong@example.com
TEST_INVALID_PASSWORD=wrongpassword

# ── Jira integration ──────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_DEVELOPER_NAME=Developer
JIRA_ASSIGNEE_ID=

# ── Optional — leave blank to disable ────────────────────────────────────────────
# JIRA_ASSIGNEE_ID already present above.
# Sprint ID from Jira Software board URL (?sprint=NNN) — assigns bug cards to active sprint.
JIRA_SPRINT_ID=
# Set by CI/CD automatically (GITHUB_RUN_NUMBER in GitHub Actions, BUILD_NUMBER in Jenkins).
# Set manually here only to test Jira build-number labels locally.
BUILD_NUMBER=
